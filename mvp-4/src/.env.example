# Configuracoes de Banco de Dados PostgreSQL
# Opcao recomendada para Supabase:
DATABASE_URL=postgresql://postgres:SUA_SENHA_DO_SUPABASE@db.srqxpnlegtrplljfuspo.supabase.co:5432/postgres
DB_SSL=true

# Opcao alternativa, usando campos separados.
# Nao coloque a connection string inteira em DB_HOST; aqui vai apenas o host.
DB_HOST=db.srqxpnlegtrplljfuspo.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_DO_SUPABASE
DB_SSL=true

# Configuracao de Ambiente
# Valores: development, test, production
NODE_ENV=development

# Configuracoes do Servidor
SERVER_PORT=3000
AUTH_SECRET=SUBSTITUA_POR_UM_SEGREDO_LONGO_E_ALEATORIO

# Configuracoes de Logging
# Valores: error, warn, info, debug, trace
LOG_LEVEL=debug

# Configuracoes de CORS
# Especifique a URL do frontend que tera acesso a API
CORS_ORIGIN=http://localhost:3000
