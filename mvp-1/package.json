{
  "name": "pulse-mais-g01",
  "version": "1.0.0",
  "description": "Aplicação web da Pulse Mais — Single Source of Truth",
  "main": "src/backend/server.ts",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx watch src/backend/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:connection": "cross-env NODE_ENV=test jest --runTestsByPath src/backend/tests/pg.connection.spec.ts",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "migrate": "tsx src/backend/db/migrations/migrate.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "ejs": "^5.0.2",
    "express": "^4.22.2",
    "l": "^0.6.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.9",
    "pg": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}