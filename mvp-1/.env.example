# ============================================================================
# Pulse Mais — modelo de variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie para .env (`cp .env.example .env`) e preencha os valores reais.
# NUNCA faça commit do .env preenchido. Os valores aqui são placeholders.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────

## URL base do projeto Supabase (obrigatório)
SUPABASE_URL=https://xxxx.supabase.co

## Chave pública (anon) — segura para uso no front-end com RLS habilitado
SUPABASE_ANON_KEY=seu_anon_key_aqui

## Chave secreta (service_role) — somente back-end, NUNCA expor no front-end
## Encontrada em: Settings → API Keys → Legacy anon, service_role API keys
SUPABASE_SERVICE_ROLE_KEY=seu_service_role_key_aqui

# ── PostgreSQL (conexão direta) ─────────────────────────────────────────────

## String de conexão direta ao Postgres (obrigatória para migrações e testes
## de conexão `npm run test:connection`). Encontrada em Supabase em
## Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres

# ── Autenticação (JWT) ──────────────────────────────────────────────────────

## Segredo usado pelo authService para assinar e validar tokens JWT do login
## passwordless. Gere um valor seguro com: `openssl rand -base64 48` (Mac/Linux)
## ou no Node: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
## Em desenvolvimento, qualquer string aleatória de 32+ caracteres funciona.
JWT_SECRET=troque_por_um_valor_aleatorio_de_no_minimo_32_caracteres

# ── Servidor ────────────────────────────────────────────────────────────────

## Porta onde o servidor Express vai rodar
PORT=3000

# ── E-mail (SMTP — opcional em desenvolvimento) ─────────────────────────────

## Configuração SMTP para envio de e-mails (RF007 — notificação de eventos)
## Deixe em branco em desenvolvimento — os e-mails são apenas logados no console.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu_usuario@exemplo.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM=noreply@pulsemais.com.br
