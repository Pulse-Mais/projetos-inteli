# Credenciais para os testes de carga (S5-T13)
# Copie este arquivo para .env.load-test e preencha com dados reais.
# .env.load-test é ignorado pelo git (não commitar credenciais).

# Usuário com perfil Aluno (deve ter jovem_id no cadastro)
LOAD_EMAIL_ALUNO=aluno@exemplo.com
LOAD_SENHA_ALUNO=senha123

# Usuário com perfil Mentor
LOAD_EMAIL_MENTOR=mentor@exemplo.com
LOAD_SENHA_MENTOR=senha123

# Usuário com perfil GestaoGeral ou GestaoPrograma
LOAD_EMAIL_GESTAO=gestao@exemplo.com
LOAD_SENHA_GESTAO=senha123
