{
  "name": "pulse-mais-api",
  "version": "1.0.0",
  "description": "API REST do projeto Pulse Mais",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/scripts/migrar.js",
    "setup:gestor": "node src/scripts/criar-gestao.js",
    "setup:mentor": "node src/scripts/criar-mentor.js",
    "setup:aluno": "node src/scripts/criar-aluno.js",
    "seed:demo": "node src/scripts/seed-demo.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:only-unit": "cross-env NODE_ENV=test jest --testMatch=\"**/src/tests/**/*.service.test.js\"",
    "test:only-integration": "cross-env NODE_ENV=test jest --testMatch=\"**/src/tests/**/*.controller.test.js\" --runInBand",
    "load:smoke": "artillery run src/scripts/load-test/artillery-smoke.yml",
    "load:carga": "artillery run src/scripts/load-test/artillery.yml"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ical-generator": "^3.6.1",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "artillery": "^2.0.32",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
